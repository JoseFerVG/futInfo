rules_version = '2';

// ===============================================================
// Assumed Data Model — Furia del Rector FC (Project: futinfo-382e8)
// ===============================================================
//
// Collection: teams/{teamId} (primary doc: furia_rector_live_v2)
//   Public read (non-PII club config), admin-only write.
//   Fields: settings (map, required, <= 40 keys), optional metadata (<= 20 root keys).
//   Forbidden keys: players, email, phone, studentId.
//
// Collection: players/{playerId}
//   Public read (non-PII FUT cards), owner or admin write.
//   Required: id (== playerId), uid (string <= 128), name (string 1..80),
//             rating (number 40..99), stats (map, 6 keys), rolesHierarchy (map <= 8 keys).
//   Optional: nickname, avatar (string <= 250000), number, cardType, faculty,
//             preferredFoot, kitColor, kitSecondary, kitCollar, kitSleeves,
//             playStyle, celebration, skillMoves, weakFoot, chemStyle,
//             availability, matchesPlayed, minutesPlayed, goals, assists,
//             yellowCards, redCards, createdAt, updatedAt (<= 35 keys total).
//   Forbidden PII keys: email, phone, studentId.
//
// Collection: playerPrivate/{playerId}
//   Strict owner & admin only (get, list, create, update, delete).
//   Required: id (== playerId), uid (string <= 128).
//   Optional: email (<= 160), phone (<= 40), studentId (<= 40), createdAt, updatedAt (<= 10 keys).
//
// Collection: matches/{matchId}
//   Public read, admin full CRUD; signed-in players may ONLY vote for their own
//   u_<uid> key inside lineup.convocatoria.
//   Required: id (== matchId), rival (1..100), date (4..32), status (enum), lineup (map <= 10 keys).
//
// Collection: matchLogs/{logId}
//   Public read, admin-only write.
//   Required: id (== logId), date (4..32), opponent (1..100), duration (1..240), entries (list <= 60).
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.get('email_verified', false) == true &&
        request.auth.token.get('email', '') == 'josef.caniles.murcia@gmail.com';
    }

    function isValidVoteStatus(val) {
      return val is string && val in ['si', 'duda', 'no', 'asistira', 'no_puede'];
    }

    // ===============================================================
    // Domain Validators (Concise — < 60 expressions per rule)
    // ===============================================================

    function isValidTeamDoc(data) {
      return data.keys().size() <= 20 &&
        !data.keys().hasAny(['players', 'email', 'phone', 'studentId']) &&
        'settings' in data &&
        data.settings is map &&
        data.settings.keys().size() <= 40 &&
        !data.settings.keys().hasAny(['players', 'email', 'phone', 'studentId']);
    }

    function isValidPlayer(data, playerId) {
      return !data.keys().hasAny(['email', 'phone', 'studentId']) &&
        data.keys().hasAll(['id', 'uid', 'name', 'rating', 'stats', 'rolesHierarchy']) &&
        data.keys().size() <= 35 &&
        data.id == playerId &&
        data.uid is string && data.uid.size() <= 128 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.rating is number && data.rating >= 40 && data.rating <= 99 &&
        data.stats is map && data.stats.keys().size() == 6 &&
        data.rolesHierarchy is map && data.rolesHierarchy.keys().size() <= 8 &&
        (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 250000));
    }

    function isValidPlayerPrivate(data, playerId) {
      return data.keys().hasAll(['id', 'uid']) &&
        data.keys().size() <= 10 &&
        data.id == playerId &&
        data.uid is string && data.uid.size() <= 128 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 160)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 40)) &&
        (!('studentId' in data) || (data.studentId is string && data.studentId.size() <= 40));
    }

    function isValidMatch(data, matchId) {
      return data.keys().hasAll(['id', 'rival', 'date', 'status', 'lineup']) &&
        data.keys().size() <= 25 &&
        data.id == matchId &&
        data.rival is string && data.rival.size() >= 1 && data.rival.size() <= 100 &&
        data.date is string && data.date.size() >= 4 && data.date.size() <= 32 &&
        data.status in ['proximo', 'finalizado', 'en_curso', 'cancelado', 'aplazado'] &&
        data.lineup is map && data.lineup.keys().size() <= 10;
    }

    function isValidSelfVote() {
      let uKey = 'u_' + request.auth.uid;
      let prevConv = resource.data.lineup.get('convocatoria', {});
      let nextConv = request.resource.data.lineup.convocatoria;
      let convDiff = nextConv.diff(prevConv).affectedKeys();
      return isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lineup', 'updatedAt']) &&
        request.resource.data.lineup.diff(resource.data.lineup).affectedKeys().hasOnly(['convocatoria']) &&
        nextConv is map && nextConv.keys().size() <= 100 &&
        (
          (convDiff.size() == 0 && nextConv == prevConv) ||
          (convDiff.hasOnly([uKey]) && uKey in nextConv && isValidVoteStatus(nextConv[uKey]))
        );
    }

    function isValidMatchLog(data, logId) {
      return data.keys().hasAll(['id', 'date', 'opponent', 'duration', 'entries']) &&
        data.keys().size() <= 20 &&
        data.id == logId &&
        data.date is string && data.date.size() >= 4 && data.date.size() <= 32 &&
        data.opponent is string && data.opponent.size() >= 1 && data.opponent.size() <= 100 &&
        data.duration is number && data.duration >= 1 && data.duration <= 240 &&
        data.entries is list && data.entries.size() <= 60;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // 1. Club configuration (non-PII): public read, admin write
    match /teams/{teamId} {
      allow read: if true;
      allow create: if isAdmin() && teamId.size() <= 80 && isValidTeamDoc(request.resource.data);
      allow update: if isAdmin() && teamId.size() <= 80 && isValidTeamDoc(request.resource.data);
      allow delete: if isAdmin();
    }

    // 2. Public FUT player cards (non-PII only): public read, owner/admin write
    match /players/{playerId} {
      allow read: if true;

      allow create: if isValidPlayer(request.resource.data, playerId) && (
        isAdmin() ||
        (
          isSignedIn() &&
          request.resource.data.uid == request.auth.uid &&
          playerId == 'u_' + request.auth.uid &&
          (!('goals' in request.resource.data) || request.resource.data.goals == 0) &&
          (!('assists' in request.resource.data) || request.resource.data.assists == 0)
        )
      );

      allow update: if isValidPlayer(request.resource.data, playerId) && (
        isAdmin() ||
        (
          isSignedIn() &&
          resource.data.get('uid', '') == request.auth.uid &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.id == resource.data.id
        )
      );

      allow delete: if isAdmin() || (
        isSignedIn() &&
        (
          resource.data.get('uid', '') == request.auth.uid ||
          playerId == 'u_' + request.auth.uid
        )
      );
    }

    // 3. Private player registration & contact PII: strict owner & admin only
    match /playerPrivate/{playerId} {
      allow get: if isAdmin() || (
        isSignedIn() && (
          playerId == 'u_' + request.auth.uid ||
          (resource != null && resource.data.get('uid', '') == request.auth.uid)
        )
      );

      allow list: if isAdmin() || (
        isSignedIn() && resource.data.uid == request.auth.uid
      );

      allow create: if isValidPlayerPrivate(request.resource.data, playerId) && (
        isAdmin() ||
        (
          isSignedIn() &&
          request.resource.data.uid == request.auth.uid &&
          playerId == 'u_' + request.auth.uid
        )
      );

      allow update: if isValidPlayerPrivate(request.resource.data, playerId) && (
        isAdmin() ||
        (
          isSignedIn() &&
          resource.data.get('uid', '') == request.auth.uid &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.id == resource.data.id
        )
      );

      allow delete: if isAdmin() || (
        isSignedIn() && (
          playerId == 'u_' + request.auth.uid ||
          (resource != null && resource.data.get('uid', '') == request.auth.uid)
        )
      );
    }

    // 4. Matches & attendance voting: public read, admin write, self-vote in lineup.convocatoria
    match /matches/{matchId} {
      allow read: if true;
      allow create: if isAdmin() && isValidMatch(request.resource.data, matchId);
      allow update: if isValidMatch(request.resource.data, matchId) && (isAdmin() || isValidSelfVote());
      allow delete: if isAdmin();
    }

    // 5. Historical match minutes logs: public read, admin write
    match /matchLogs/{logId} {
      allow read: if true;
      allow create: if isAdmin() && isValidMatchLog(request.resource.data, logId);
      allow update: if isAdmin() &&
        isValidMatchLog(request.resource.data, logId) &&
        request.resource.data.id == resource.data.id;
      allow delete: if isAdmin();
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
